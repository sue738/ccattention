#!/usr/bin/env python3
"""ccattention - how much of your attention did Claude Code actually cost?

Judging an assistant by its token count or its uptime misses what you actually
spend. The cost you pay is **how many times you had to type**, so divide that
by the number of conversations:

  last 14 days: 1582 utterances / 299 sessions = **5.3 utterances per session**

An earlier version split the day into tasks using a 90-minute idle gap. That
threshold produced the answer instead of measuring it: a day of continuous
typing never crossed it, so 239 utterances collapsed into "one task"; a quiet
day yielded zero tasks and the ratio was undefined (CV 1.15 over 30 days).
Sessions have no tuning parameter -- same 30 days, CV 0.56, defined every day.

**Being computable changed the question, though.** "How many turns to finish
one job" is still not measured -- a session is not a unit of work, so one
session covering three topics reads long. What is measured is session length.
For the friction itself, read the self-correction and pushback columns.

  ccattention              by day
  ccattention --weekly     by week
  ccattention --days N     range
  ccattention --json

Output is English by default; set CCATTENTION_LANG=ja (or a ja locale) for
Japanese.
"""
import collections
import datetime
import glob
import json
import os
import re
import sys

# 兄弟ツール(ccflaky/ccskillstats/ccsendstats)と同じ規約: 英語が既定で、
# CCATTENTION_LANG か ロケールが ja のときだけ日本語。npmで配る以上、
# 既定が日本語だと大半の利用者が読めない(初見レビューで指摘)。
JA = bool(re.match(r"^ja", os.environ.get("CCATTENTION_LANG")
                   or os.environ.get("LC_ALL")
                   or os.environ.get("LC_MESSAGES")
                   or os.environ.get("LANG") or "", re.I))


def L(en, ja):
    return ja if JA else en


PROJECTS = os.path.expanduser("~/.claude/projects")
SKIP = ("Another Claude", "<", "Base directory", "This session is being continued",
        "Stop hook", "Caveat", "# ")
# ユーザーが打たずに済んだはずのもの。分類は粗いが、推移を見るには足りる。
STATUS = re.compile(r"^(進んでる|動いてる|続けてる|終わった|進んだ|動ける|今何|今どんな|今止ま|まだ|どうなった)")
APPROVE = re.compile(r"^(はい|うん|ok|OK|いいよ|いいです|やって|やろう|やりましょう|お願い"
                     r"|進めて|続けて|そう|それで|このまま|着手|する|やる|了解|よろしく|[0-9a-c]$)")
# 私が直前の自分の出力を否定した本文。品質の指標としてはこれが最も直接的で、
# 実測では平常 1.7〜3.9% に対し、失敗が続いた日は 10.0% に跳ねた。
SELFFIX = re.compile(r"訂正します|誤りでした|間違って|外れました|戻します|撤回"
                     r"|私の(誤り|失敗|見落と)|信用できません|数え直|取り下げ|前提が崩れ")
NUDGE = re.compile(r"(止まってる|また止ま|作りますと言って|言って(作業|実装)してない|続けて|なんで止)")


def local_date(ts):
    """The local calendar day of a transcript timestamp.

    Timestamps are UTC ('...Z'). Slicing the string named the UTC day, so east
    of UTC anything before the offset hour (09:00 in Tokyo) was counted under
    the day before.
    """
    try:
        return datetime.datetime.fromisoformat(ts.replace("Z", "+00:00")).astimezone().date()
    except ValueError:
        return datetime.date.fromisoformat(ts[:10])


def day(ts):
    return local_date(ts).isoformat()


def week(ts):
    d = local_date(ts)
    return (d - datetime.timedelta(days=d.weekday())).isoformat()


def collect(days):
    cut = (datetime.datetime.now(datetime.timezone.utc)
           - datetime.timedelta(days=days)).isoformat()
    rows = collections.defaultdict(lambda: {
        "user": 0, "user_chars": 0, "mine": 0, "mine_chars": 0,
        "status": 0, "approve": 0, "nudge": 0, "blocks": 0, "bursts": 0,
        "threads": 0, "selffix": 0})
    for f in glob.glob(PROJECTS + "/**/*.jsonl", recursive=True):
        if os.sep + "subagents" + os.sep in f:
            continue
        try:
            if os.path.getsize(f) > 200_000_000:
                continue
        except OSError:
            continue
        run = 0
        last_ts = None
        counted_days = set()
        for line in open(f, errors="ignore"):
            if '"user"' not in line and '"assistant"' not in line:
                continue
            try:
                e = json.loads(line)
            except ValueError:
                continue
            ts = e.get("timestamp") or ""
            if not ts or ts < cut:
                continue
            c = (e.get("message") or {}).get("content")
            if e.get("type") == "user":
                txt = c if isinstance(c, str) else next(
                    (b.get("text", "") for b in (c or [])
                     if isinstance(b, dict) and b.get("type") == "text"), "")
                if not txt or not txt.strip():
                    continue
                s = txt.strip()
                # フックが差し戻した回数は、その本文が戻ってくることで分かる
                if s.startswith("Stop hook"):
                    if last_ts:
                        rows[last_ts]["blocks"] += 1
                    continue
                if s.startswith(SKIP) or len(s) > 600:
                    continue
                r = rows[ts]
                last_ts = ts
                # 用件の単位 = 「その日に実際に話したセッション」(1ファイル=1セッション)。
                #
                # 以前は「前の発話から90分空いたら新しい用件」という時間ギャップ
                # だったが、実測で破綻していた: 1日中打ち続けた日は区切りが一度も
                # 入らず239発話が"1用件"になり、逆に発話の少ない日は0用件で計算
                # 不能になる(30日実測でCV=1.15、範囲1.5〜239、31日中29日しか出ない)。
                # 閾値は観測ではなく仮定なので、仮定が答えを作ってしまっていた。
                #
                # セッション単位にするとチューニングパラメータが消えて観測事実
                # だけになる(同じ30日でCV=0.56、範囲3.0〜50、31日すべてで算出可)。
                # 限界は正直に: 1セッションで複数の話題を扱えば用件を過小に数える。
                # ただし「無い区切りを発明する」ことはしない方を選ぶ。
                d_ = day(ts)
                if d_ not in counted_days:
                    counted_days.add(d_)
                    r["threads"] += 1
                if run >= 4:
                    r["bursts"] += 1
                run = 0
                r["user"] += 1
                r["user_chars"] += len(s)
                if STATUS.match(s):
                    r["status"] += 1
                elif NUDGE.search(s):
                    r["nudge"] += 1
                elif len(s) <= 15 and APPROVE.match(s):
                    r["approve"] += 1
            elif e.get("type") == "assistant" and isinstance(c, list):
                tx = [b.get("text", "") for b in c
                      if isinstance(b, dict) and b.get("type") == "text" and b.get("text", "").strip()]
                if tx and last_ts:
                    rows[last_ts]["mine"] += 1
                    rows[last_ts]["mine_chars"] += len(tx[-1])
                    if SELFFIX.search(tx[-1]):
                        rows[last_ts]["selffix"] += 1
                    run += 1
    return rows


def fold(rows, keyfn):
    out = collections.defaultdict(lambda: collections.Counter())
    for ts, v in rows.items():
        k = keyfn(ts)
        for kk, vv in v.items():
            out[k][kk] += vv
    return dict(sorted(out.items()))


def main():
    argv = sys.argv[1:]
    if "-h" in argv or "--help" in argv:
        print(__doc__)
        return 0
    # 未知のフラグを黙って捨てると、typo(--dyas 3)が「全期間の集計」として
    # 成功してしまい、間違ったデータを正しい答えだと思って読むことになる
    # (初見レビューで実際に踏まれた)。知らないものは受け取らない。
    known = {"--weekly", "--json", "--days", "-h", "--help"}
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--days":
            if i + 1 >= len(argv) or not argv[i + 1].lstrip("-").isdigit():
                print(L("--days needs a number, e.g. --days 30",
                        "--days には数値が必要です (例: --days 30)"), file=sys.stderr)
                return 2
            i += 2
            continue
        if a not in known:
            print(L(f"unknown option: {a}", f"知らないオプション: {a}"), file=sys.stderr)
            print(L("try --help", "--help を参照してください"), file=sys.stderr)
            return 2
        i += 1

    days = int(argv[argv.index("--days") + 1]) if "--days" in argv else 21
    rows = collect(days)
    folded = fold(rows, week if "--weekly" in argv else day)
    if "--json" in argv:
        print(json.dumps({k: dict(v) for k, v in folded.items()}, ensure_ascii=False, indent=2))
        return 0
    if not folded:
        print(L("no data in that range", "該当する期間のデータがありません"))
        return 0
    print(f"{L('period','期間'):<12}{L('sess','ｾｯｼｮﾝ'):>6}{L('you','あなた'):>7}"
          f"{L('per sess','発話/ｾｯｼｮﾝ'):>10}{L('mine','私の通数'):>8}{L('per utt','通/発話'):>8}"
          f"{L('read min','読む分'):>9}{L('selffix','自己訂正'):>8}{L('status','状況確認'):>8}"
          f"{L('nudge','催促'):>6}{L('block','差戻'):>6}")
    for k, v in folded.items():
        u = max(v["user"], 1)
        th = max(v["threads"], 1)
        print(f"{k:<12}{v['threads']:>6}{v['user']:>7}{v['user']/th:>10.1f}"
              f"{v['mine']:>8}{v['mine']/u:>8.1f}{v['mine_chars']/400:>9.0f}"
              f"{v['selffix']/max(v['mine'],1)*100:>7.1f}%"
              f"{v['status']:>8}{v['nudge']:>6}{v['blocks']:>6}")
    print(L("\n  sess = conversations you actually spoke in that day. Baseline: 5.3 utterances/session (last 14 days).",
            "\n  セッション = その日に実際に話した会話ウィンドウの数。実測基準値は 5.3 発話/セッション(直近14日)。"))
    print(L("  That is conversation length, not how heavy the work was -- job-level effort is not measured here.",
            "  これはセッションの長さであって、仕事の重さではない — 仕事単位は測れていない。"))
    print(L("  For the friction itself, read the selffix and block columns.",
            "  負担そのものを見るなら自己訂正・差戻の列の方が直接的。"))
    return 0


if __name__ == "__main__":
    sys.exit(main())
